local function waitForKiciaClient(state)
    local players = game:GetService('Players')
    local deadline = os.clock() + 90

    local function await(stage, check)
        state.stage = stage
        repeat
            local value = check()
            if value then return value end
            task.wait(0.25)
        until os.clock() >= deadline
        error('Startup timed out at ' .. stage .. '; Kicia was not started.', 0)
    end

    await('initial replication', function() return game:IsLoaded() end)
    if game.GameId ~= 6035872082 then
        error('This script is for Rivals. Kicia was not started.', 0)
    end
    local player = await('LocalPlayer', function() return players.LocalPlayer end)
    local scripts = await('PlayerScripts', function() return player:FindFirstChild('PlayerScripts') end)
    local controllers = await('PlayerScripts.Controllers', function() return scripts:FindFirstChild('Controllers') end)
    local module = await('PlayerDataController module', function() return controllers:FindFirstChild('PlayerDataController') end)
    assert(module:IsA('ModuleScript'), 'PlayerDataController is not a ModuleScript.')

    -- Prefer the game's already-loaded module; do not force its UI controllers to boot.
    local env = getgenv()
    local enumerate = getloadedmodules or env.getloadedmodules
    local canEnumerate = false
    if type(enumerate) == 'function' then
        local ok, modules = pcall(enumerate)
        canEnumerate = ok and type(modules) == 'table'
    end
    if canEnumerate then
        await('game loading PlayerDataController', function()
            local ok, modules = pcall(enumerate)
            if not ok or type(modules) ~= 'table' then
                error('Cannot inspect loaded modules: ' .. tostring(modules), 0)
            end
            for _, item in pairs(modules) do
                if item == module then return true end
            end
        end)
    else
        -- Executors without module enumeration get a conservative structural gate.
        await('character, camera and PlayerGui', function()
            local character = player.Character
            return character and character:FindFirstChildOfClass('Humanoid')
                and character:FindFirstChild('HumanoidRootPart')
                and workspace.CurrentCamera and player:FindFirstChildOfClass('PlayerGui')
        end)
        local notBefore = os.clock() + 3
        await('client startup settling', function() return os.clock() >= notBefore end)
    end

    -- Require only this data controller once. Retrying all game modules can leave
    -- partially initialized singletons and does not repair a failed game bootstrap.
    local completed, ok, controller = false
    task.spawn(function()
        ok, controller = pcall(require, module)
        completed = true
    end)
    -- A late result after timeout cannot start Kicia. Do not cancel the game's
    -- own ModuleScript initializer while it may still be yielding.
    await('reading PlayerDataController', function() return completed end)
    if not ok then
        error(module:GetFullName() .. ': ' .. tostring(controller), 0)
    end
    assert(type(controller) == 'table', 'PlayerDataController did not return a table.')
    await('PlayerDataController.CurrentData', function()
        local data = rawget(controller, 'CurrentData')
        return type(data) == 'table' and rawget(data, 'Data') ~= nil
            and type(data.Get) == 'function'
    end)
    -- Let the game's settings listeners run before loading dependent UI modules.
    local notBefore = os.clock() + 1
    await('player data settling', function() return os.clock() >= notBefore end)
    return true
end

